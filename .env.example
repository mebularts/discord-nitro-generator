# MackolApp Configuration
# Copy this file to .env and modify as needed

# License verification
LICENSE_VERIFICATION_URL=https://adofon.linkol.in/maclicense.php

# Telegram contact
TELEGRAM_CONTACT=https://t.me/mebularts

# Application settings
APP_NAME=MackolApp
APP_VERSION=2.0.0

# Selenium settings
SELENIUM_TIMEOUT=20
SELENIUM_IMPLICIT_WAIT=10

# Chrome options
CHROME_HEADLESS=false
CHROME_DISABLE_GPU=true
CHROME_NO_SANDBOX=true